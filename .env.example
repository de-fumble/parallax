# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Supabase (Project Settings → API) ---------------------------------------
# VITE_* values are bundled into the browser; they must be the public URL and
# the publishable key only.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Same two values again, for server code.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key. Bypasses row level security — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- AI report generation ------------------------------------------------------
# Any OpenAI-compatible chat completions API. Defaults to DeepSeek.
AI_API_KEY=""
# Optional overrides (defaults shown). AI_MODEL may list several models
# separated by commas; they are tried left to right.
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-v4-pro"

# Optional further providers, tried in order whenever the ones before fail.
# AI_FALLBACK_API_KEY=""
# AI_FALLBACK_BASE_URL=""
# AI_FALLBACK_MODEL=""
# AI_FALLBACK_2_API_KEY=""   (and _BASE_URL, _MODEL; likewise AI_FALLBACK_3_*)

# --- Web search ------------------------------------------------------------------
# Only needed when "Search the web" is on. Set one or both; when both are set,
# Exa is tried first and Tavily takes over if it fails.
EXA_API_KEY=""
TAVILY_API_KEY=""
# Optional: change the order, e.g. "tavily,exa".
# SEARCH_ORDER="exa,tavily"

# --- Retries when the AI provider is down (optional) ----------------------------
# The gap before each automatic retry grows by this much: 1 step, then 2, … up
# to 10. Defaults to one minute.
# RESEARCH_RETRY_STEP_MS="60000"

# --- Background worker (optional) ------------------------------------------------
# Retries are driven by a timer inside the server process, which is all a
# long-running server needs. On hosts that only run code during a request
# (Vercel, Netlify, Cloudflare) set a secret here and have a scheduled job call
# POST /api/worker once a minute with "Authorization: Bearer <secret>".
# WORKER_SECRET=""
# Set to "off" to stop the in-process timer, e.g. when a separate job does the work.
# RESEARCH_WORKER="off"
